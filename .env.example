# Environment Variables Example
# Front-end API configuration

# Base URL for AI pollution reporting backend (defaults to local server)
VITE_API_BASE_URL=http://localhost:8787

# Optional custom URLs for data and river geojson
# VITE_DATA_URL=/data/readings.json
# VITE_GEOJSON_URL=/data/river.geojson
# VITE_RIVERS_URL=/data/rivers-india.geojson
